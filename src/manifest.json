{
  "manifest_version": 3,
  "name": "HelloDev",
  "version": "1.0.0",
  "description": "A personal new tab dashboard with shared DevDash bug, PR and CL queries.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "topSites",
    "sessions",
    "favicon"
  ],
  "action": {
    "default_title": "HelloDev",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "hellodev.html"
  }
}
