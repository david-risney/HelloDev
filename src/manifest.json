{
  "manifest_version": 3,
  "name": "HelloDev",
  "version": "1.0.0",
  "description": "A simple custom new tab page extension",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "identity",
    "storage",
    "topSites",
    "sessions",
    "favicon"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://*.googlesource.com/*",
    "https://issuetracker.googleapis.com/*",
    "https://issues.chromium.org/*",
    "https://devboxes.azure.com/*",
    "https://*.devcenter.azure.com/*"
  ],
  "action": {
    "default_title": "HelloDev",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "hellodev.html"
  }
}
